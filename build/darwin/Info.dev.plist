<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>marasi-app</string>
        <key>CFBundleExecutable</key>
        <string>marasi-app</string>
        <key>CFBundleIdentifier</key>
        <string>com.wails.marasi-app</string>
        <key>CFBundleVersion</key>
        <string>1.0.0</string>
        <key>CFBundleGetInfoString</key>
        <string>Built using Wails (https://wails.io)</string>
        <key>CFBundleShortVersionString</key>
        <string>1.0.0</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>
        <key>LSMinimumSystemVersion</key>
        <string>12.0.0</string>
        <key>NSHighResolutionCapable</key>
        <string>true</string>
        <key>NSHumanReadableCopyright</key>
        <string>Copyright.........</string>
        <!-- The web view reaches Marasi's control API over plain HTTP, and a
             remote can be any host (a Tailscale 100.x address, a LAN IP, a
             hostname). Without these keys ATS blocks every non-loopback
             fetch and /events stream, and a remote never connects.
             NSAllowsArbitraryLoadsInWebContent exempts WKWebView loads only,
             not URLSession; NSAllowsLocalNetworking allows IP addresses and
             .local names, which macOS 14+ otherwise refuses. -->
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsArbitraryLoadsInWebContent</key>
            <true/>
            <key>NSAllowsLocalNetworking</key>
            <true/>
        </dict>
    </dict>
</plist>
